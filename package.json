{
  "name": "rainshare",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Send your agent to help with someone else's idea or project.",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lexicons": "node lexicons/publish.mjs",
    "lexicons:check": "node lexicons/publish.mjs --check",
    "build:cli": "node -e \"import('./vite.config.js').then(m => m.bundleCli('dist-cli'))\"",
    "test": "node --test test/*.test.mjs",
    "plants": "node scripts/render-plants.mjs && node scripts/og-plants.mjs",
    "plants:og": "node scripts/og-plants.mjs",
    "og": "node scripts/og-home.mjs",
    "bluesky": "node scripts/bluesky.mjs",
    "logo": "node scripts/render-logo.mjs && node -e \"require('fs').copyFileSync('public/logo.png', 'api/_og/logo.png')\""
  },
  "dependencies": {
    "@atproto/oauth-client-browser": "0.5.10",
    "@fontsource/zen-maru-gothic": "^5.3.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/og": "0.11.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "vite": "^8.3.5"
  }
}
