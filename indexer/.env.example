# /root/rainshare-index/.env on the droplet (mode 600), read by systemd (EnvironmentFile) and by
# `npm run backfill`. No quotes around values. Never commit the real one. See README.md.

# Supabase project "atpota.to" (zdzjtziydmwkxbzlkwxv), where Rainshare's terms ledger already
# lives. Service role: the same two values as /root/atpotato-garden/.env. Both are required.
SUPABASE_URL=https://zdzjtziydmwkxbzlkwxv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Everything below is optional; the defaults are shown.

# Jetstream v2 hosts, comma-separated, tried in order. One connection at a time.
# JETSTREAM_HOSTS=wss://jetstream2.us-east.bsky.network,wss://jetstream1.us-east.bsky.network

# Where a reconcile finds the repos with Rainshare records (listReposByCollection), and where it
# resolves did:plc documents to find each repo's PDS.
# RELAY_URL=https://relay1.us-east.bsky.network
# PLC_URL=https://plc.directory

# /healthz, on localhost only. Poe's services use 8787, 8790 and 8791; the announcer 8792.
# HOST=127.0.0.1
# PORT=8793

# Jetstream cursors and when the last reconcile finished, relative to the data folder.
# STATE_FILE=state.json

# A full reconcile against every repo this often (hours).
# RECONCILE_HOURS=6
# Reconnect to Jetstream this often (minutes), from the saved cursor.
# RECYCLE_MINUTES=15

# debug, info, warn or error.
# LOG_LEVEL=info
