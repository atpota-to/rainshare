[Unit]
Description=Rainshare index: every dev.rainshare.* record, from Jetstream to Supabase
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root

# Code from the deploy (atpota-to/rainshare, installed by droplet/deploy.sh into
# /root/rainshare-live/current). Secrets and state.json stay in the data folder, which is the
# working directory. Node resolves the link at start, so a running process keeps reading its own
# release even after the next deploy switches it.
WorkingDirectory=/root/rainshare-index
# Node 22 explicitly: the droplet's default node is 18, which has no WebSocket.
ExecStart=/opt/node22/bin/node /root/rainshare-live/current/indexer/src/index.js
EnvironmentFile=/root/rainshare-index/.env

# Everything it writes is idempotent, and on start it resumes Jetstream from the cursor in
# state.json, so a restart (or a kill -9) loses nothing; a reconcile covers anything a cursor
# can't.
Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rainshare-index
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=80

# A tiny stream: Jetstream filtered to dev.rainshare.*, a few events an hour. The reconcile pages
# through each Rainshare repo a hundred records at a time. Its own process and connection, held
# well under the droplet's 960 MB beside Poe's services and the announcer.
MemoryHigh=96M
MemoryMax=128M
CPUQuota=25%
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
