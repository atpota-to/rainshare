# /root/rainshare-announcer/.env on the droplet. Never commit the real one.

# dry: every run says what it would post and send, in the journal, and does neither.
# live: it posts and sends. Start with dry, read a few runs, then switch.
MODE=dry

# An app password for @rainshare.dev, made with "Allow access to your direct messages" ticked.
RAINSHARE_BLUESKY_APP_PASSWORD=

# The index (indexer/): the Supabase project "atpota.to", service role, the same two values as
# /root/rainshare-index/.env. Without them each run reads every repo instead, which is slower.
SUPABASE_URL=https://zdzjtziydmwkxbzlkwxv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Where the site is, for every link in a post or a message.
RAINSHARE_SITE=https://rainshare.dev

# GET /health, on 127.0.0.1 only. Poe's services use 8787, 8790 and 8791.
PORT=8792

# A run after whatever Jetstream missed, and for what only time brings. Minutes.
SWEEP_MINUTES=15

# How often to look for replies to the account's messages, so a STOP is answered. Seconds.
INBOX_SECONDS=60
